#!/bin/sh
set -eu

notify() { if command -v notify-send >/dev/null 2>&1; then notify-send "$@" || :; fi; }
session=x11
if [ "${XDG_SESSION_TYPE:-}" = wayland ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then session=wayland; fi

# Also support an installation unpacked into the user's home.
PATH="$PATH:$HOME/.local/opt/galinia-capture/usr/bin"
export PATH
if [ "$session" = wayland ]; then tools='grim slurp wl-copy'; else tools='xfce4-screenshooter'; fi
for tool in $tools; do
    if ! command -v "$tool" >/dev/null; then
        notify "Screenshot unavailable" "Missing $tool. See Galinia First Steps."
        exit 1
    fi
done

if [ "$session" = wayland ]; then
    region=$(slurp -b '#00000070' -c '#efb579ff' -w 2) || exit 0
    [ -n "$region" ] || exit 0
fi

pictures=$(xdg-user-dir PICTURES 2>/dev/null) || pictures="$HOME/Pictures"
[ -n "$pictures" ] || pictures="$HOME/Pictures"
directory="$pictures/Screenshots"
mkdir -p "$directory"
capture=$(mktemp "$directory/Screenshot-$(date +%F-%H%M%S)-XXXXXX.png")
trap 'rm -f "$capture"' EXIT
if [ "$session" = x11 ]; then
    if ! xfce4-screenshooter --region --save "$capture"; then
        notify "Screenshot failed" "No image was captured."
        exit 1
    fi
    # Escape can return success without writing an image.
    [ -s "$capture" ] || exit 0
    trap - EXIT
    helper="$(dirname "$(readlink -f "$0")")/../share/galinia/screenshot-clipboard.py"
    exec /usr/bin/python3 "$helper" "$capture"
fi
if ! grim -g "$region" -t png "$capture"; then
    notify "Screenshot failed" "The compositor did not return an image."
    exit 1
fi
trap - EXIT
if wl-copy --type image/png < "$capture"; then
    notify "Screenshot saved and copied" "$capture"
else
    notify "Screenshot saved; clipboard failed" "$capture"
    exit 1
fi
