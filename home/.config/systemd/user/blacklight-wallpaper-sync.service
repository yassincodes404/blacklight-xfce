[Unit]
Description=Blacklight Live Wallpaper Color Sync Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/blacklight-wallpaper-sync.py --watch
Restart=always
RestartSec=2

# Started by galinia-session.desktop after importing the display environment.
