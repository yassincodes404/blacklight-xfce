[Unit]
Description=Blacklight Live Wallpaper Color Sync Daemon
After=graphical-session.target

[Service]
Type=simple
# Import DISPLAY from the current graphical session before starting.
ExecStart=/usr/bin/python3 %h/.local/bin/blacklight-wallpaper-sync.py --watch
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
