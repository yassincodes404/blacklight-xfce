[Unit]
Description=Galinia Desktop System Monitor
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/sysmon-widget.py
Restart=on-failure
RestartSec=5

# Started by galinia-session.desktop after importing the display environment.
